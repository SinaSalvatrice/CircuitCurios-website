{{- $textures := slice -}}
{{- range where .Site.RegularPages "Section" "textures" -}}
  {{- $textures = $textures | append (dict
    "title" .Title
    "slug" .File.ContentBaseName
    "group" (.Params.group | default "")
    "family" (.Params.family | default "")
    "pattern" (.Params.pattern | default "")
    "principle" (.Params.principle | default "")
    "description" (.Params.description | default "")
    "image" (.Params.image | default "")
    "sourcePage" (.Params.sourcePage | default "")
  ) -}}
{{- end -}}
{{- dict "schemaVersion" .Site.Params.schemaVersion "textures" $textures | jsonify -}}
