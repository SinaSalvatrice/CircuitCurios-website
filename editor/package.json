{
  "name": "circuitcurios-grapes-editor",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Local GrapesJS visual editor for the CircuitCurios website.",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "grapesjs": "0.23.6"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "de.circuitcurios.grapeseditor",
    "productName": "CircuitCurios GrapesJS Editor",
    "asar": true,
    "directories": { "output": "dist" },
    "files": [
      "main.mjs",
      "preload.cjs",
      "index.html",
      "editor.js",
      "editor.css",
      "package.json",
      "node_modules/grapesjs/dist/**/*"
    ],
    "win": {
      "executableName": "circuitcurios_grapes_editor"
    }
  }
}
